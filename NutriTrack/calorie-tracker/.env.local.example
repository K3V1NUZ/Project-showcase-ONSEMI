# Optional. Leave these unset to run in demo mode (data in browser localStorage).
# To use a real backend, create a Supabase project, run supabase/migrations/*.sql
# in order, then copy this file to .env.local and fill in your own values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
